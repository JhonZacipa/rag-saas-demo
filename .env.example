# Copy this file to .env and adjust the values. Never commit .env.

# --- Backend ---
APP_ENV=local
LOG_LEVEL=INFO
# true = JSON logs (production style), false = human readable logs
LOG_JSON=false
DATABASE_URL=postgresql://rag:change-me-local@127.0.0.1:5432/rag

# --- Postgres container (docker compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=rag
POSTGRES_PORT=5432

# --- Ports on this machine (8000 and 3000 are often taken by other projects) ---
BACKEND_PORT=8010
FRONTEND_PORT=3010

# --- Frontend (server side only) ---
BACKEND_URL=http://127.0.0.1:8010
